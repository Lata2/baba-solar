# ─── Baba Solars server — copy to server/.env and fill in ────────────────────────────
# These are SERVER secrets. They are never bundled into the website. Do not commit server/.env.

# Where the admin panel is opened from (comma-separated). Used for CSRF checks and the Google redirect.
#   Office PC:  http://localhost:8787
#   VPS:        https://babasolars.in
APP_ORIGIN=http://localhost:8787
PORT=8787
# 127.0.0.1 = only this computer can open it. Use 0.0.0.0 behind a reverse proxy on a VPS.
HOST=127.0.0.1
# true when a reverse proxy (Nginx/Caddy) terminates HTTPS in front of the server.
TRUST_PROXY=false
# Session cookie "Secure" flag. Defaults to true when every APP_ORIGIN is https://.
# COOKIE_SECURE=true

# ─── First start only: creates the first admin (remove ADMIN_PASSWORD afterwards) ──────
ADMIN_EMAIL=admin@babasolars.com
ADMIN_NAME=Baba Solars Admin
# Min 10 characters, mix of upper/lower case, numbers, symbols.
ADMIN_PASSWORD=

# ─── Document storage ─────────────────────────────────────────────────────────────────
# Default on Windows: C:\Quotation and Billing  (Quotations\ and Billing\ are created inside)
# Default elsewhere:  ./server-data/Quotation and Billing
# DOCUMENTS_ROOT=C:\Quotation and Billing
# One sub-folder per client inside Quotations / Billing
CLIENT_SUBFOLDERS=true
MAX_UPLOAD_MB=15
# Users, sessions, document registry and the encrypted Google token (keep private, back it up).
# DATA_DIR=./server-data

# ─── Google Drive backup (babasolars76@gmail.com) ──────────────────────────────────────
# Google Cloud Console → APIs & Services: enable "Google Drive API", OAuth consent screen,
# Credentials → OAuth client ID → "Web application", Authorised redirect URI:
#   <APP_ORIGIN>/api/drive/oauth/callback     e.g. http://localhost:8787/api/drive/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8787/api/drive/oauth/callback
DRIVE_ACCOUNT_EMAIL=babasolars76@gmail.com
DRIVE_ROOT_FOLDER=Quotation and Billing
# 32 random bytes, base64 — encrypts the stored Google refresh token. Generate: npm run server:keygen
TOKEN_ENCRYPTION_KEY=
DRIVE_POLL_SECONDS=20
DRIVE_MAX_ATTEMPTS=8

# ─── Windows sync agent (only when the server runs on a VPS) ───────────────────────────
# Long random token(s), comma-separated. Generate: npm run server:keygen. Put the same value in agent/agent.env.
AGENT_TOKENS=

# ─── Website hosting ──────────────────────────────────────────────────────────────────
# Serve the built site from dist/ (run `npm run build:server` first).
SERVE_FRONTEND=true
SESSION_HOURS=8
SESSION_IDLE_MINUTES=120
NODE_ENV=production
