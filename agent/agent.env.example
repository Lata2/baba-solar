# Baba Solars sync agent — copy to agent/agent.env on the office Windows PC.
# Address of the Baba Solars server (https:// for a VPS).
SERVER_URL=https://babasolars.in
# Same value as one of AGENT_TOKENS in the server's server/.env (read-only access to documents).
AGENT_TOKEN=
# Where the files are written.
LOCAL_ROOT=C:\Quotation and Billing
# How often to check for new / changed documents (seconds, minimum 15).
POLL_SECONDS=60
