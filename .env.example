# ─── Baba Solars website — environment (optional) ───────────────────────────
# Everything in VITE_* is PUBLIC (bundled into the browser code) — never put secrets here.
# Server secrets (Google OAuth, encryption key, admin password) go in server/.env — see server/.env.example.

# Public website URL used for canonical links and SEO tags.
VITE_SITE_URL=https://babasolars.in

# Server mode is switched on by `npm run build:server` (reads .env.server). Normally leave these alone.
# VITE_SERVER_MODE=true
# VITE_API_BASE_URL=          (empty = same origin as the website)
