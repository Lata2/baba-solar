# ─── Baba Solars website — environment (optional) ───────────────────────────
# Everything in VITE_* is PUBLIC: it is compiled into the browser JavaScript. Never put secrets here.

# Public website URL used for canonical links and SEO tags.
VITE_SITE_URL=https://babasolars.in

# Optional: override the frontend-only admin login (default admin@babasolars.com / Admin@123).
# These values are visible in the built JavaScript — this is a convenience gate, not security.
# VITE_ADMIN_EMAIL=
# VITE_ADMIN_PASSWORD=

# ─── Website enquiries → Google Sheet + admin email (Google Apps Script) ─────
# Paste the Web App URL from Apps Script → Deploy → Web app (it ends with /exec). See SETUP.md.
# Leave empty to skip Sheets/email (enquiries still go to Admin → Enquiries and WhatsApp).
VITE_APPS_SCRIPT_URL=
# Same value as the API_TOKEN Script Property. Use a long random string (e.g. 32+ characters).
# Note: it is visible in the built JavaScript — it blocks casual misuse, it is not a password.
VITE_APPS_SCRIPT_TOKEN=
# Who sends the Sheet row + email: "client" (default — this website calls the Apps Script) or "server"
# (after a backend such as a Firebase Cloud Function takes over delivery on enquiry create).
# VITE_ENQUIRY_DELIVERY=client
# Optional: WhatsApp number that receives enquiries (country code + number). Default 919203900410.
# VITE_ENQUIRY_WHATSAPP=919203900410
