{
  "rewrites": [
    {
      "source": "/((?!assets/|site-data\\.json$).*)",
      "destination": "/spa.html"
    }
  ],
  "headers": [
    {
      "source": "/site-data.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
